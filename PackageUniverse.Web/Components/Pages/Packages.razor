@page "/packages"
@using System.Text.Json
@using PackageUniverse.Application.Models

<PageTitle>Package Universe</PageTitle>

<div class="packages-container">
    <div class="header">
        <h1>NuGet Package Universe</h1>
        <p>Bubble size represents the number of package versions. Lines indicate dependencies.</p>
        <div class="controls">
            <input type="text" 
                   @bind="searchTerm" 
                   @bind:event="oninput"
                   placeholder="Search packages..." 
                   class="search-input" />
            <span class="package-count">@filteredPackages.Count() packages</span>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading">
            <div class="spinner"></div>
            <p>Loading packages...</p>
        </div>
    }
    else if (error is not null)
    {
        <div class="error">
            <p>@error</p>
            <button @onclick="LoadPackages" class="btn-retry">Retry</button>
        </div>
    }
    else
    {
        <div class="graph-container">
            <svg class="package-svg" 
                 @ref="svgElement"
                 viewBox="@viewBox"
                 preserveAspectRatio="xMidYMid meet">
                <defs>
                    <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
                        <feGaussianBlur stdDeviation="3" result="coloredBlur"/>
                        <feMerge>
                            <feMergeNode in="coloredBlur"/>
                            <feMergeNode in="SourceGraphic"/>
                        </feMerge>
                    </filter>
                    <radialGradient id="bubbleGradient" cx="35%" cy="35%" r="65%">
                        <stop offset="0%" style="stop-color:#60a5fa;stop-opacity:0.9" />
                        <stop offset="100%" style="stop-color:#3b82f6;stop-opacity:0.7" />
                    </radialGradient>
                    <radialGradient id="bubbleGradientHover" cx="35%" cy="35%" r="65%">
                        <stop offset="0%" style="stop-color:#93c5fd;stop-opacity:1" />
                        <stop offset="100%" style="stop-color:#60a5fa;stop-opacity:0.85" />
                    </radialGradient>
                </defs>

                <!-- Dependency lines -->
                @foreach (var edge in visibleEdges)
                {
                    <line x1="@edge.SourceX" y1="@edge.SourceY" 
                          x2="@edge.TargetX" y2="@edge.TargetY" 
                          class="dependency-line"
                          stroke-width="1.5" />
                }

                <!-- Package bubbles -->
                @foreach (var pkg in positionedPackages)
                {
                    <g class="bubble-group" 
                       @onclick="() => SelectPackage(pkg)"
                       @onmouseover="() => HoverPackage(pkg)"
                       @onmouseout="ClearHover">
                        <circle cx="@pkg.X" cy="@pkg.Y" r="@pkg.Radius" 
                                class="package-bubble @(isSelected(pkg) ? "selected" : "") @(isHovered(pkg) ? "hovered" : "")"
                                fill="url(#bubbleGradient@(isHovered(pkg) ? "Hover" : ""))" />
                        <text x="@pkg.X" y="@pkg.Y" 
                              class="bubble-label"
                              text-anchor="middle" 
                              dominant-baseline="central">
                            <tspan x="@pkg.X" dy="-0.4em" class="bubble-name">@GetDisplayName(pkg.Name)</tspan>
                            @if (pkg.Versions.Any())
                            {
                                <tspan x="@pkg.X" dy="1.2em" class="bubble-version">@pkg.Versions.Count versions</tspan>
                            }
                        </text>
                    </g>
                }
            </svg>

            @if (selectedPackage is not null)
            {
                <div class="package-details">
                    <h3>@selectedPackage.Name</h3>
                    @if (!string.IsNullOrEmpty(selectedPackage.Description))
                    {
                        <p class="description">@selectedPackage.Description</p>
                    }
                    <div class="stats">
                        <span class="stat">
                            <strong>@selectedPackage.Versions.Count</strong> versions
                        </span>
                        <span class="stat">
                            <strong>@selectedPackage.Dependencies.Count</strong> dependencies
                        </span>
                    </div>
                    @if (selectedPackage.Dependencies.Any())
                    {
                        <div class="dependencies-list">
                            <h4>Dependencies:</h4>
                            <ul>
                                @foreach (var dep in selectedPackage.Dependencies.Take(10))
                                {
                                    <li>
                                        <span class="dep-name">@dep.TargetPackageName</span>
                                        @if (!string.IsNullOrEmpty(dep.TargetVersionRange))
                                        {
                                            <span class="dep-version">(@dep.TargetVersionRange)</span>
                                        }
                                    </li>
                                }
                                @if (selectedPackage.Dependencies.Count > 10)
                                {
                                    <li class="more-deps">... and @(selectedPackage.Dependencies.Count - 10) more</li>
                                }
                            </ul>
                        </div>
                    }
                    <button @onclick="() => selectedPackage = null" class="btn-close">Close</button>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<PackageModel> packages = [];
    private IEnumerable<PackageModel> filteredPackages => 
        string.IsNullOrWhiteSpace(searchTerm) 
            ? packages 
            : packages.Where(p => p.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    private string searchTerm = string.Empty;
    private bool isLoading = true;
    private string? error;
    private PackageModel? selectedPackage;
    private PackageModel? hoveredPackage;
    private ElementReference svgElement;
    private string viewBox = "0 0 1200 800";

    private List<PositionedPackage> positionedPackages = [];
    private List<PackageEdge> visibleEdges = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadPackages();
    }

    private async Task LoadPackages()
    {
        isLoading = true;
        error = null;
        try
        {
            // Try to load from the API service via Aspire service discovery
            var httpClient = new HttpClient();
            httpClient.BaseAddress = new Uri("https+http://apiservice");
            
            var response = await httpClient.GetAsync("/api/packages");
            if (response.IsSuccessStatusCode)
            {
                var jsonOptions = new JsonSerializerOptions 
                { 
                    PropertyNameCaseInsensitive = true 
                };
                packages = (await response.Content.ReadFromJsonAsync<List<PackageModel>>(jsonOptions)) 
                           ?? new List<PackageModel>();
                
                PositionPackages();
            }
            else
            {
                error = $"Failed to load packages: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            error = $"Error loading packages: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void PositionPackages()
    {
        var pkgs = filteredPackages.ToList();
        if (!pkgs.Any())
        {
            positionedPackages.Clear();
            visibleEdges.Clear();
            return;
        }

        // Calculate radii based on version count
        var minVersions = pkgs.Min(p => p.Versions.Count);
        var maxVersions = pkgs.Max(p => p.Versions.Count);
        var versionRange = maxVersions - minVersions;

        positionedPackages = pkgs.Select(p =>
        {
            var normalizedSize = versionRange > 0 
                ? (double)(p.Versions.Count - minVersions) / versionRange 
                : 0.5;
            var radius = 20 + normalizedSize * 60; // 20-80px radius
            return new PositionedPackage
            {
                Model = p,
                Name = p.Name,
                Versions = p.Versions,
                Dependencies = p.Dependencies,
                Radius = radius
            };
        }).ToList();

        // Force-directed-like layout
        LayoutPackages();

        // Calculate edges
        UpdateEdges();
    }

    private void LayoutPackages()
    {
        if (!positionedPackages.Any()) return;

        var width = 1200;
        var height = 800;
        var centerX = width / 2;
        var centerY = height / 2;

        // Initial placement: sort by size and place in a spiral
        var sorted = positionedPackages.OrderByDescending(p => p.Radius).ToList();
        var nameSet = new HashSet<string>(sorted.Select(p => p.Name));

        for (var i = 0; i < sorted.Count; i++)
        {
            var angle = i * 0.5;
            var dist = 50 + i * 12;
            sorted[i].X = centerX + Math.Cos(angle) * dist;
            sorted[i].Y = centerY + Math.Sin(angle) * dist;
        }

        // Simple repulsion simulation
        var repulsionStrength = 5000.0;
        var attractionStrength = 0.005;
        var idealDistance = 150.0;
        var iterations = 100;

        for (var iter = 0; iter < iterations; iter++)
        {
            var temperature = 1.0 - (double)iter / iterations;

            // Repulsion between all pairs
            for (var i = 0; i < sorted.Count; i++)
            {
                var fx = 0.0;
                var fy = 0.0;

                for (var j = 0; j < sorted.Count; j++)
                {
                    if (i == j) continue;

                    var dx = sorted[i].X - sorted[j].X;
                    var dy = sorted[i].Y - sorted[j].Y;
                    var dist = Math.Sqrt(dx * dx + dy * dy) + 0.01;
                    var minDist = sorted[i].Radius + sorted[j].Radius + 30;

                    if (dist < minDist * 3)
                    {
                        var force = repulsionStrength / (dist * dist);
                        fx += (dx / dist) * force;
                        fy += (dy / dist) * force;
                    }
                }

                sorted[i].X += fx * temperature * 0.5;
                sorted[i].Y += fy * temperature * 0.5;
            }

            // Attraction along edges (dependencies pull packages together)
            var edgeSet = new HashSet<string>();
            foreach (var pkg in sorted)
            {
                foreach (var dep in pkg.Dependencies)
                {
                    if (!nameSet.Contains(dep.TargetPackageName)) continue;
                    var edgeKey = $"{pkg.Name}-{dep.TargetPackageName}";
                    var reverseKey = $"{dep.TargetPackageName}-{pkg.Name}";
                    if (edgeSet.Contains(edgeKey) || edgeSet.Contains(reverseKey)) continue;
                    edgeSet.Add(edgeKey);

                    var target = sorted.FirstOrDefault(p => p.Name == dep.TargetPackageName);
                    if (target is null) continue;

                    var dx = target.X - pkg.X;
                    var dy = target.Y - pkg.Y;
                    var dist = Math.Sqrt(dx * dx + dy * dy) + 0.01;

                    if (dist > idealDistance)
                    {
                        var force = (dist - idealDistance) * attractionStrength;
                        var moveX = (dx / dist) * force;
                        var moveY = (dy / dist) * force;

                        pkg.X += moveX * temperature;
                        pkg.Y += moveY * temperature;
                        target.X -= moveX * temperature * 0.5;
                        target.Y -= moveY * temperature * 0.5;
                    }
                }
            }
        }

        // Center the layout
        var minX = sorted.Min(p => p.X - p.Radius);
        var maxX = sorted.Max(p => p.X + p.Radius);
        var minY = sorted.Min(p => p.Y - p.Radius);
        var maxY = sorted.Max(p => p.Y + p.Radius);

        var layoutWidth = maxX - minX;
        var layoutHeight = maxY - minY;
        var offsetX = centerX - (minX + layoutWidth / 2);
        var offsetY = centerY - (minY + layoutHeight / 2);

        // Scale to fit
        var scaleX = (width - 100) / layoutWidth;
        var scaleY = (height - 100) / layoutHeight;
        var scale = Math.Min(scaleX, scaleY);

        foreach (var pkg in sorted)
        {
            pkg.X = (pkg.X - minX - layoutWidth / 2) * scale + centerX;
            pkg.Y = (pkg.Y - minY - layoutHeight / 2) * scale + centerY;
            pkg.Radius *= Math.Sqrt(scale);
        }
    }

    private void UpdateEdges()
    {
        var nameToPkg = positionedPackages.ToDictionary(p => p.Name);
        var edgeSet = new HashSet<string>();

        visibleEdges.Clear();

        foreach (var pkg in positionedPackages)
        {
            foreach (var dep in pkg.Dependencies)
            {
                if (!nameToPkg.TryGetValue(dep.TargetPackageName, out var target)) continue;

                var edgeKey = $"{pkg.Name}->{dep.TargetPackageName}";
                if (edgeSet.Contains(edgeKey)) continue;
                edgeSet.Add(edgeKey);

                visibleEdges.Add(new PackageEdge
                {
                    Source = pkg.Name,
                    Target = dep.TargetPackageName,
                    SourceX = pkg.X,
                    SourceY = pkg.Y,
                    TargetX = target.X,
                    TargetY = target.Y,
                    VersionRange = dep.TargetVersionRange
                });
            }
        }
    }

    private string GetDisplayName(string name)
    {
        if (name.Length <= 12) return name;
        return name[..10] + "...";
    }

    private bool isSelected(PositionedPackage pkg) => selectedPackage?.Name == pkg.Name;
    private bool isHovered(PositionedPackage pkg) => hoveredPackage?.Name == pkg.Name;

    private void SelectPackage(PositionedPackage pkg)
    {
        selectedPackage = selectedPackage?.Name == pkg.Name ? null : pkg.Model;
    }

    private void HoverPackage(PositionedPackage pkg)
    {
        hoveredPackage = pkg.Model;
    }

    private void ClearHover()
    {
        hoveredPackage = null;
    }

    private class PositionedPackage
    {
        public PackageModel Model { get; init; } = null!;
        public string Name { get; init; } = string.Empty;
        public List<PackageVersionModel> Versions { get; init; } = [];
        public List<PackageDependencyModel> Dependencies { get; init; } = [];
        public double X { get; set; }
        public double Y { get; set; }
        public double Radius { get; set; }
    }

    private class PackageEdge
    {
        public string Source { get; init; } = string.Empty;
        public string Target { get; init; } = string.Empty;
        public double SourceX { get; set; }
        public double SourceY { get; set; }
        public double TargetX { get; set; }
        public double TargetY { get; set; }
        public string VersionRange { get; init; } = string.Empty;
    }
}
