@page "/packages"
@using System.Text.Json
@using PackageUniverse.Application.Models

<PageTitle>Package Universe - Visual Explorer</PageTitle>

<div class="packages-container">
    @if (isLoading)
    {
        <div class="loading">
            <div class="spinner"></div>
            <p>Loading packages...</p>
        </div>
    }
    else if (error is not null)
    {
        <div class="error">
            <p>@error</p>
            <button @onclick="LoadPackages" class="btn-retry">Retry</button>
        </div>
    }
    else
    {
        <div class="canvas-wrapper" 
             @onmousedown="OnMouseDown" 
             @onmousemove="OnMouseMove" 
             @onmouseup="OnMouseUp" 
             @onmouseleave="OnMouseUp"
             @onwheel="OnWheel">
            <div class="canvas-controls">
                <button @onclick="ZoomIn" class="control-btn" title="Zoom In">+</button>
                <button @onclick="ZoomOut" class="control-btn" title="Zoom Out">-</button>
                <button @onclick="ResetView" class="control-btn" title="Reset View">R</button>
            </div>
            
            <div class="canvas-container" @ref="canvasContainer">
                <div class="canvas-content" style="transform: translate(@(translateX)px, @(translateY)px) scale(@(zoomLevel)); transform-origin: center;">
                    <svg class="package-svg" width="2000" height="2000" viewBox="0 0 2000 2000">
                        <defs>
                            <radialGradient id="bubbleGradient1" cx="35%" cy="35%" r="65%">
                                <stop offset="0%" style="stop-color:#60a5fa;stop-opacity:0.95" />
                                <stop offset="100%" style="stop-color:#3b82f6;stop-opacity:0.75" />
                            </radialGradient>
                            <radialGradient id="bubbleGradient2" cx="35%" cy="35%" r="65%">
                                <stop offset="0%" style="stop-color:#a78bfa;stop-opacity:0.95" />
                                <stop offset="100%" style="stop-color:#8b5cf6;stop-opacity:0.75" />
                            </radialGradient>
                            <radialGradient id="bubbleGradient3" cx="35%" cy="35%" r="65%">
                                <stop offset="0%" style="stop-color:#34d399;stop-opacity:0.95" />
                                <stop offset="100%" style="stop-color:#10b981;stop-opacity:0.75" />
                            </radialGradient>
                            <filter id="glow">
                                <feGaussianBlur stdDeviation="3" result="coloredBlur"/>
                                <feMerge>
                                    <feMergeNode in="coloredBlur"/>
                                    <feMergeNode in="SourceGraphic"/>
                                </feMerge>
                            </filter>
                        </defs>
                        
                        @foreach (var edge in edges)
                        {
                            <line x1="@edge.SourceX" y1="@edge.SourceY" 
                                  x2="@edge.TargetX" y2="@edge.TargetY" 
                                  class="dependency-line"
                                  stroke-width="2" />
                        }
                        
                        @foreach (var pkg in positionedPackages)
                        {
                            var gradientId = $"bubbleGradient{((pkg.Name.GetHashCode() % 3) + 3) % 3 + 1}";
                            var transformValue = $"translate({pkg.X.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)}, {pkg.Y.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)})";
                            var circleRadius = pkg.Radius.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
                            var foX = (-pkg.Radius).ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
                            var foWidth = (pkg.Radius * 2).ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
                            <g class="bubble-group" 
                               @onclick="(() => SelectPackage(pkg))"
                               style="cursor: pointer;"
                               transform="@transformValue">
                                <circle cx="0" cy="0" r="@circleRadius" 
                                        class="package-bubble @(selectedPackage?.Name == pkg.Name ? "selected" : "")"
                                        fill="url(#@gradientId)"
                                        filter="url(#glow)" />
                                <foreignObject x="@foX" y="@foX" width="@foWidth" height="@foWidth">
                                    <div xmlns="http://www.w3.org/1999/xhtml" class="bubble-text-container">
                                        <div class="bubble-name">@GetDisplayName(pkg.Name)</div>
                                        @if (pkg.Downloads > 0)
                                        {
                                            <div class="bubble-downloads">@FormatDownloads(pkg.Downloads)</div>
                                        }
                                    </div>
                                </foreignObject>
                            </g>
                        }
                    </svg>
                </div>
            </div>
            
            @if (selectedPackage is not null)
            {
                <div class="package-popup">
                    <button @onclick="(() => selectedPackage = null)" class="popup-close">x</button>
                    <h3 class="popup-title">@selectedPackage.Name</h3>
                    @if (!string.IsNullOrEmpty(selectedPackage.Description))
                    {
                        <p class="popup-description">@selectedPackage.Description</p>
                    }
                    <div class="popup-stats">
                        <div class="stat-item">
                            <span class="stat-label">Downloads</span>
                            <span class="stat-value">@FormatDownloads(selectedPackage.TotalDownloads)</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">Dependencies</span>
                            <span class="stat-value">@selectedPackage.Dependencies.Count</span>
                        </div>
                    </div>
                    @if (selectedPackage.Dependencies.Any())
                    {
                        <div class="popup-deps">
                            <h4>Dependencies:</h4>
                            <ul>
                                @foreach (var dep in selectedPackage.Dependencies.Take(5))
                                {
                                    <li>@dep.TargetPackageName</li>
                                }
                                @if (selectedPackage.Dependencies.Count > 5)
                                {
                                    <li class="more">+ @(selectedPackage.Dependencies.Count - 5) more</li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private static double Cos(double x) => Math.Cos(x);
    private static double Sin(double x) => Math.Sin(x);
    private static double Sqrt(double x) => Math.Sqrt(x);
    
    private List<PackageModel> packages = new List<PackageModel>();
    private bool isLoading = true;
    private string? error;
    private PackageModel? selectedPackage;
    
    private ElementReference canvasContainer;
    private double translateX = 0;
    private double translateY = 0;
    private double zoomLevel = 1.0;
    private bool isDragging = false;
    private double lastMouseX = 0;
    private double lastMouseY = 0;
    
    private List<PositionedPackage> positionedPackages = new List<PositionedPackage>();
    private List<Edge> edges = new List<Edge>();
    
    protected override async Task OnInitializedAsync()
    {
        await LoadPackages();
    }
    
    private async Task LoadPackages()
    {
        isLoading = true;
        error = null;
        try
        {
            try
            {
                var httpClient = new HttpClient();
                httpClient.BaseAddress = new Uri("http://localhost:5000");
                
                var response = await httpClient.GetAsync("/api/packages");
                if (response.IsSuccessStatusCode)
                {
                    var jsonOptions = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                    packages = (await response.Content.ReadFromJsonAsync<List<PackageModel>>(jsonOptions)) ?? new List<PackageModel>();
                    PositionPackages();
                    isLoading = false;
                    return;
                }
            }
            catch { }
            
            packages = GenerateMockPackages();
            PositionPackages();
        }
        catch (Exception ex)
        {
            error = string.Format("Error loading packages: {0}", ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }
    
    private List<PackageModel> GenerateMockPackages()
    {
        return new List<PackageModel>
        {
            new PackageModel { Name = "Newtonsoft.Json", Description = "Json.NET framework", TotalDownloads = 500000000, Dependencies = new List<PackageDependencyModel>() },
            new PackageModel { Name = "Microsoft.Extensions.DependencyInjection", Description = "DI services", TotalDownloads = 300000000, Dependencies = new List<PackageDependencyModel> { new PackageDependencyModel { TargetPackageName = "Microsoft.Extensions.Logging.Abstractions" } } },
            new PackageModel { Name = "Serilog", Description = "Structured logging", TotalDownloads = 150000000, Dependencies = new List<PackageDependencyModel>() },
            new PackageModel { Name = "AutoMapper", Description = "Object mapper", TotalDownloads = 120000000, Dependencies = new List<PackageDependencyModel>() },
            new PackageModel { Name = "Dapper", Description = "Micro-ORM", TotalDownloads = 180000000, Dependencies = new List<PackageDependencyModel>() },
            new PackageModel { Name = "Microsoft.Extensions.Logging.Abstractions", Description = "Logging abstractions", TotalDownloads = 280000000, Dependencies = new List<PackageDependencyModel>() },
            new PackageModel { Name = "System.Text.Json", Description = "JSON processing", TotalDownloads = 400000000, Dependencies = new List<PackageDependencyModel>() },
            new PackageModel { Name = "FluentValidation", Description = "Validation library", TotalDownloads = 90000000, Dependencies = new List<PackageDependencyModel>() },
            new PackageModel { Name = "MediatR", Description = "Mediator pattern", TotalDownloads = 75000000, Dependencies = new List<PackageDependencyModel>() },
            new PackageModel { Name = "Polly", Description = "Resilience library", TotalDownloads = 95000000, Dependencies = new List<PackageDependencyModel> { new PackageDependencyModel { TargetPackageName = "Microsoft.Extensions.Logging.Abstractions" } } },
            new PackageModel { Name = "Moq", Description = "Mocking framework", TotalDownloads = 110000000, Dependencies = new List<PackageDependencyModel>() },
            new PackageModel { Name = "xunit", Description = "Testing framework", TotalDownloads = 200000000, Dependencies = new List<PackageDependencyModel>() },
            new PackageModel { Name = "EntityFrameworkCore", Description = "Modern ORM", TotalDownloads = 250000000, Dependencies = new List<PackageDependencyModel> { new PackageDependencyModel { TargetPackageName = "Microsoft.Extensions.Logging.Abstractions" }, new PackageDependencyModel { TargetPackageName = "Microsoft.Extensions.DependencyInjection" } } },
            new PackageModel { Name = "StackExchange.Redis", Description = "Redis client", TotalDownloads = 85000000, Dependencies = new List<PackageDependencyModel>() },
            new PackageModel { Name = "NLog", Description = "Logging platform", TotalDownloads = 70000000, Dependencies = new List<PackageDependencyModel>() }
        };
    }
    
    private void PositionPackages()
    {
        if (!packages.Any()) { positionedPackages.Clear(); edges.Clear(); return; }
        
        var sorted = packages.OrderByDescending(p => p.TotalDownloads).ToList();
        var maxDownloads = sorted.Max(p => p.TotalDownloads);
        var minDownloads = sorted.Min(p => p.TotalDownloads);
        
        var centerX = 1000.0;
        var centerY = 1000.0;
        
        positionedPackages = new List<PositionedPackage>();
        var nameToPkg = new Dictionary<string, PositionedPackage>();
        
        if (sorted.Any())
        {
            var first = sorted[0];
            var radius = CalculateRadius(first.TotalDownloads, minDownloads, maxDownloads);
            var pkg = new PositionedPackage { Model = first, Name = first.Name, Downloads = first.TotalDownloads, Dependencies = first.Dependencies, X = centerX, Y = centerY, Radius = radius };
            positionedPackages.Add(pkg);
            nameToPkg[first.Name] = pkg;
        }
        
        var angleStep = 0.5;
        var distanceStep = 80.0;
        var currentAngle = 0.0;
        var currentDistance = 150.0;
        
        for (int i = 1; i < sorted.Count; i++)
        {
            var pkgData = sorted[i];
            var radius = CalculateRadius(pkgData.TotalDownloads, minDownloads, maxDownloads);
            var x = centerX + Cos(currentAngle) * currentDistance;
            var y = centerY + Sin(currentAngle) * currentDistance;
            
            var pkg = new PositionedPackage { Model = pkgData, Name = pkgData.Name, Downloads = pkgData.TotalDownloads, Dependencies = pkgData.Dependencies, X = x, Y = y, Radius = radius };
            positionedPackages.Add(pkg);
            nameToPkg[pkgData.Name] = pkg;
            
            currentAngle += angleStep;
            currentDistance += distanceStep;
        }
        
        ApplyForceLayout(nameToPkg);
        BuildEdges(nameToPkg);
    }
    
    private double CalculateRadius(int downloads, int min, int max)
    {
        var diff = Math.Max(1, max - min);
        var normalized = (double)(downloads - min) / diff;
        return 25 + normalized * 100;
    }
    
    private void ApplyForceLayout(Dictionary<string, PositionedPackage> nameToPkg)
    {
        var iterations = 50;
        var repulsionStrength = 50000.0;
        var attractionStrength = 0.01;
        var idealDistance = 200.0;
        
        for (var iter = 0; iter < iterations; iter++)
        {
            var temperature = 1.0 - (double)iter / iterations;
            
            foreach (var pkg1 in positionedPackages)
            {
                var fx = 0.0;
                var fy = 0.0;
                
                foreach (var pkg2 in positionedPackages)
                {
                    if (pkg1 == pkg2) continue;
                    var dx = pkg1.X - pkg2.X;
                    var dy = pkg1.Y - pkg2.Y;
                    var dist = Sqrt(dx * dx + dy * dy) + 0.1;
                    if (dist < 300)
                    {
                        var force = repulsionStrength / (dist * dist);
                        fx += (dx / dist) * force;
                        fy += (dy / dist) * force;
                    }
                }
                pkg1.X += fx * temperature * 0.3;
                pkg1.Y += fy * temperature * 0.3;
            }
            
            foreach (var pkg in positionedPackages)
            {
                foreach (var dep in pkg.Dependencies)
                {
                    if (!nameToPkg.TryGetValue(dep.TargetPackageName, out var target)) continue;
                    var dx = target.X - pkg.X;
                    var dy = target.Y - pkg.Y;
                    var dist = Sqrt(dx * dx + dy * dy) + 0.1;
                    if (dist > idealDistance)
                    {
                        var force = (dist - idealDistance) * attractionStrength;
                        var moveX = (dx / dist) * force;
                        var moveY = (dy / dist) * force;
                        pkg.X += moveX * temperature;
                        pkg.Y += moveY * temperature;
                        target.X -= moveX * temperature * 0.5;
                        target.Y -= moveY * temperature * 0.5;
                    }
                }
            }
        }
        
        var avgX = positionedPackages.Average(p => p.X);
        var avgY = positionedPackages.Average(p => p.Y);
        var offsetX = 1000 - avgX;
        var offsetY = 1000 - avgY;
        
        foreach (var pkg in positionedPackages)
        {
            pkg.X += offsetX;
            pkg.Y += offsetY;
        }
    }
    
    private void BuildEdges(Dictionary<string, PositionedPackage> nameToPkg)
    {
        edges.Clear();
        var edgeSet = new HashSet<string>();
        
        foreach (var pkg in positionedPackages)
        {
            foreach (var dep in pkg.Dependencies)
            {
                if (!nameToPkg.TryGetValue(dep.TargetPackageName, out var target)) continue;
                var edgeKey = string.Format("{0}-{1}", (pkg.Name.CompareTo(dep.TargetPackageName) < 0 ? pkg.Name : dep.TargetPackageName), (pkg.Name.CompareTo(dep.TargetPackageName) < 0 ? dep.TargetPackageName : pkg.Name));
                if (edgeSet.Contains(edgeKey)) continue;
                edgeSet.Add(edgeKey);
                edges.Add(new Edge { SourceX = pkg.X, SourceY = pkg.Y, TargetX = target.X, TargetY = target.Y });
            }
        }
    }
    
    private string GetDisplayName(string name) => name.Length <= 15 ? name : name.Substring(0, 12) + "...";
    
    private string FormatDownloads(int downloads)
    {
        if (downloads >= 1000000) return string.Format("{0:F1}M", downloads / 1000000.0);
        if (downloads >= 1000) return string.Format("{0:F1}K", downloads / 1000.0);
        return downloads.ToString();
    }
    
    private void SelectPackage(PositionedPackage pkg) => selectedPackage = selectedPackage != null && selectedPackage.Name == pkg.Name ? null : pkg.Model;
    
    private void ZoomIn() { var newZoom = Math.Min(3.0, zoomLevel * 1.2); zoomLevel = newZoom; }
    private void ZoomOut() { var newZoom = Math.Max(0.3, zoomLevel / 1.2); zoomLevel = newZoom; }
    private void ResetView() { translateX = 0; translateY = 0; zoomLevel = 1.0; }
    
    private void OnMouseDown(MouseEventArgs e) { isDragging = true; lastMouseX = e.ClientX; lastMouseY = e.ClientY; }
    
    private void OnMouseMove(MouseEventArgs e)
    {
        if (!isDragging) return;
        translateX += e.ClientX - lastMouseX;
        translateY += e.ClientY - lastMouseY;
        lastMouseX = e.ClientX;
        lastMouseY = e.ClientY;
    }
    
    private void OnMouseUp(MouseEventArgs e) => isDragging = false;
    
    private void OnWheel(WheelEventArgs e)
    {
        var delta = e.DeltaY > 0 ? 0.9 : 1.1;
        zoomLevel = Math.Max(0.3, Math.Min(3.0, zoomLevel * delta));
    }
    
    private class PositionedPackage
    {
        public PackageModel Model { get; init; } = null!;
        public string Name { get; init; } = string.Empty;
        public int Downloads { get; init; }
        public List<PackageDependencyModel> Dependencies { get; init; } = new List<PackageDependencyModel>();
        public double X { get; set; }
        public double Y { get; set; }
        public double Radius { get; set; }
    }
    
    private class Edge { public double SourceX { get; set; } public double SourceY { get; set; } public double TargetX { get; set; } public double TargetY { get; set; } }
}

<style>
    .packages-container { min-height: 100vh; background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); overflow: hidden; }
    .loading, .error { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 100vh; color: #94a3b8; }
    .spinner { width: 50px; height: 50px; border: 4px solid #334155; border-top-color: #60a5fa; border-radius: 50%; animation: spin 1s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
    .btn-retry { margin-top: 1.5rem; padding: 0.75rem 2rem; background: #3b82f6; color: white; border: none; border-radius: 8px; cursor: pointer; font-size: 1rem; }
    .btn-retry:hover { background: #2563eb; }
    .canvas-wrapper { position: relative; width: 100vw; height: 100vh; overflow: hidden; user-select: none; -webkit-user-select: none; -moz-user-select: none; -ms-user-select: none; }
    .canvas-controls { position: absolute; top: 1rem; right: 1rem; z-index: 100; display: flex; gap: 0.5rem; }
    .control-btn { width: 40px; height: 40px; border: none; border-radius: 8px; background: rgba(30, 41, 59, 0.8); color: #e2e8f0; font-size: 1.5rem; cursor: pointer; transition: all 0.2s ease; display: flex; align-items: center; justify-content: center; }
    .control-btn:hover { background: #3b82f6; transform: scale(1.1); }
    .canvas-container { width: 100%; height: 100%; overflow: hidden; cursor: grab; touch-action: none; }
    .canvas-container:active { cursor: grabbing; }
    .canvas-content { will-change: transform; }
    .package-svg { width: 2000px; height: 2000px; }
    .dependency-line { stroke: rgba(148, 163, 184, 0.4); stroke-dasharray: 5 3; animation: dashFlow 3s linear infinite; }
    @keyframes dashFlow { to { stroke-dashoffset: -16; } }
    .package-bubble { transition: all 0.2s ease; stroke: #475569; stroke-width: 2; }
    .package-bubble:hover { stroke: #60a5fa; stroke-width: 3; filter: drop-shadow(0 0 10px rgba(96, 165, 250, 0.6)); }
    .package-bubble.selected { stroke: #a78bfa; stroke-width: 4; filter: drop-shadow(0 0 15px rgba(167, 139, 250, 0.8)); }
    .bubble-text-container { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; text-align: center; padding: 5px; overflow: hidden; pointer-events: none; }
    .bubble-name { color: #f1f5f9; font-size: 11px; font-weight: 600; line-height: 1.2; word-break: break-word; text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5); }
    .bubble-downloads { color: #cbd5e1; font-size: 9px; margin-top: 2px; opacity: 0.9; }
    .package-popup { position: absolute; top: 1rem; left: 1rem; width: 300px; background: rgba(30, 41, 59, 0.95); border: 1px solid #475569; border-radius: 12px; padding: 1.5rem; box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5); z-index: 100; backdrop-filter: blur(10px); }
    .popup-close { position: absolute; top: 0.5rem; right: 0.75rem; background: none; border: none; color: #94a3b8; font-size: 1.5rem; cursor: pointer; transition: color 0.2s; }
    .popup-close:hover { color: #e2e8f0; }
    .popup-title { margin: 0 0 0.75rem; color: #60a5fa; font-size: 1.25rem; word-break: break-word; padding-right: 1.5rem; }
    .popup-description { color: #cbd5e1; font-size: 0.9rem; line-height: 1.5; margin: 0 0 1rem; }
    .popup-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem; }
    .stat-item { background: rgba(51, 65, 85, 0.5); padding: 0.75rem; border-radius: 8px; text-align: center; }
    .stat-label { display: block; color: #64748b; font-size: 0.75rem; margin-bottom: 0.25rem; }
    .stat-value { display: block; color: #60a5fa; font-size: 1.1rem; font-weight: 600; }
    .popup-deps h4 { color: #cbd5e1; font-size: 0.9rem; margin: 0 0 0.5rem; }
    .popup-deps ul { margin: 0; padding-left: 1.2rem; list-style: none; max-height: 150px; overflow-y: auto; }
    .popup-deps li { color: #94a3b8; font-size: 0.8rem; margin: 0.25rem 0; }
    .popup-deps li.more { color: #475569; font-style: italic; }
</style>
